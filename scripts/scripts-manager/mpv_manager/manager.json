    "dest": "~~/scripts/utils/smart-track-selector/smart-track-selector.lua",
    "branch": "main"
  },
  {
    "git": "https://github.com/davidde/mpv-autosub",
    "whitelist": "autosub.lua",
    "dest": "~~/scripts/subtitles/mpv-autosub/mpv-autosub.lua",
    "branch": "master",
    "replacements": [
      {
        "search": "local subliminal = '/home/david/.local/bin/subliminal'",
        "replace": "local subliminal = 'subliminal'"
      }
    ]
  },
  {
    "git": "https://github.com/hacel/recent",
    "whitelist": "recent.lua",
    "dest": "~~/scripts/utils/recent/recent.lua",

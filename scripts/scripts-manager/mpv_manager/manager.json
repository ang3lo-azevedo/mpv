    "branch": "master",
    "replacements": [
      {
        "search": "local subliminal = '/home/david/.local/bin/subliminal'",
        "replace": "local subliminal = 'subliminal'"
      }
    ]
  },
  {
    "git": "https://github.com/hacel/recent",
    "whitelist": "recent.lua",
    "dest": "~~/scripts/utils/recent/recent.lua",
    "branch": "master"
  },
  {
    "git": "https://github.com/po5/mpv-auto-chapters",
    "whitelist": "autochapters/main.lua",
    "dest": "~~/scripts/utils/mpv-auto-chapters/mpv-auto-chapters.lua",
    "branch": "master",
    "replacements": [
      {
        "search": "local script_name, script_dir = mp.get_script_name(), mp.get_script_directory()",
        "replace": "local script_name, script_dir = mp.get_script_name(), mp.get_script_directory() or mp.command_native({\"expand-path\", \"~~/script-opts\"})"
      }
    ]

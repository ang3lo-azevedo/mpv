[
  {
    "git": "https://github.com/allecsc/Stremio-Kai/",
    "whitelist": "portable_config/scripts/notify_skip",
    "base_dir": "portable_config/scripts/notify_skip",
    "dest": "~~/scripts/ui/notify_skip",
    "branch": "main",
    "replacements": [
      {
        "search": "mp.msg.info(\"Content type unknown, waiting for metadata...\")",
        "replace": "mp.msg.info(\"Content type unknown, falling back to series for local playback\"); finalize_setup() -- [Local Override] Bypass Stremio IPC metadata latch for local playback"
      },
      {
        "search": "local border_color = 'f55b7b'  -- Purple accent (BGR)",
        "replace": "local border_color = 'FFFFFF'  -- White accent (matches hayase-osc)"
      },
      {
        "search": "hint_text = \"Press Tab\",",
        "replace": "hint_text = \"[Tab]\","
      },
      {
        "search": "self.hint_text = hint_text or \"Press Tab\"",
        "replace": "self.hint_text = hint_text or \"[Tab]\""
      }
    ]
  },
  {
    "git": "https://github.com/allecsc/Stremio-Kai/",
    "whitelist": "portable_config/input.conf",
    "dest": "~~/input.conf",
    "branch": "main",
    "replacements": [
      {
        "search": "q       \tquit",
        "replace": "#q       \tquit"
      },
      {
        "search": "`\t\t    script-message cycle-audio-preset",
        "replace": "\\\t\t    script-message cycle-audio-preset"
      },
      {
        "search": "Ctrl+F12\tvf toggle @BWDIF:lavfi=[bwdif=mode=1:parity=auto:deint=all],@SVP:vapoursynth=\"~~/svp_main.vpy\":buffered-frames=8:concurrent-frames=16 ; show-text \"Deinterlace + SVP\" 3000",
        "replace": "Ctrl+F12\tvf toggle @BWDIF:lavfi=[bwdif=mode=1:parity=auto:deint=all],@SVP:vapoursynth=\"~~/svp_main.vpy\":buffered-frames=8:concurrent-frames=16 ; show-text \"Deinterlace + SVP\" 3000\n\n# Test\n#u cycle-values sub-ass-override \"force\" \"strip\" \"scale\"# toggle overriding SSA/ASS subtitle styles with the normal styles\n\n# Mouse bindings\nMBTN_LEFT cycle pause"
      }
    ]
  },
  {
    "git": "https://github.com/nekoxuee/hayase-osc",
    "whitelist": "hayase-osc.lua",
    "dest": "~~/scripts/ui/osc/hayase-osc/hayase-osc.lua",
    "branch": "main",
    "replacements": [
      {
        "search": "idlescreen = true,                     -- show mpv logo when idle",
        "replace": "scale = 1.0, idlescreen = true,        -- UI scale factor added via mpv_manager"
      },
      {
        "search": "osc_param.playresy = dimensions.h > 0 and dimensions.h or 720",
        "replace": "osc_param.playresy = (dimensions.h > 0 and dimensions.h or 720) / (user_opts.scale or 1.0)"
      }
    ]
  },
  {
    "git": "https://github.com/nekoxuee/hayase-osc",
    "whitelist": "Lucide.ttf",
    "dest": "~~/fonts/Lucide.ttf",
    "branch": "main"
  },
  {
    "git": "https://github.com/dnlzqn/nata-sans",
    "whitelist": "NataSans[wght].ttf",
    "dest": "~~/fonts/NataSans[wght].ttf",
    "branch": "main"
  },
  {
    "git": "https://github.com/po5/thumbfast",
    "whitelist": "thumbfast.lua",
    "dest": "~~/scripts/ui/other/thumbnails/thumbfast/thumbfast.lua"
  },
  {
    "git": "https://github.com/thisisshihan/mpv-player-config-snad/",
    "whitelist": "pause-indicator.lua",
    "dest": "~~/scripts/ui/other/pause-indicator/pause-indicator.lua",
    "branch": "mpv-config-snad-windows-ubuntu-linux-macos"
  },
  {
    "git": "https://github.com/mosquito-byte/mpv-interactive-video",
    "whitelist": "interactive-video.lua",
    "dest": "~~/scripts/utils/mpv-interactive-video/mpv-interactive-video.lua"
  },
  {
    "git": "https://github.com/AzuredBlue/mpv-anilist-updater",
    "whitelist": "main.lua",
    "dest": "~~/scripts/utils/tracking/anilistUpdater/anilistUpdater.lua",
    "branch": "main",
    "replacements": [
      {
        "search": "return \"python3\"",
        "replace": "return \"mpv-python\""
      }
    ]
  },
  {
    "git": "https://github.com/allecsc/Stremio-Kai/",
    "whitelist": "profile-manager.lua",
    "dest": "~~/scripts/ui/other/profile-manager/profile-manager.lua",
    "branch": "main",
    "replacements": [
      {
        "search": "if not state.metadata_ready then",
        "replace": "if false and not state.metadata_ready then -- [Local Override] Bypass Stremio IPC metadata latch to apply profiles immediately"
      },
      {
        "search": "local color_profile = meta.color_profile or \"kai\"",
        "replace": "local color_profile = meta.color_profile or \"original\" -- [Local Override] Neutral default when no Stremio metadata"
      },
      {
        "search": "mp.set_property(\"tone-mapping\", \"bt.2446a\")",
        "replace": "mp.set_property(\"tone-mapping\", \"spline\") -- [Local Override] Developer-recommended for gpu-next"
      },
      {
        "search": "mp.set_property(\"hdr-peak-percentile\", \"99.8\")",
        "replace": "mp.set_property(\"hdr-peak-percentile\", \"99.995\") -- [Local Override] Preserves specular highlights"
      }
    ]
  },
  {
    "git": "https://github.com/allecsc/Stremio-Kai/",
    "whitelist": "reactive_vf_bypass.lua",
    "dest": "~~/scripts/utils/reactive_vf_bypass/reactive_vf_bypass.lua",
    "branch": "main"
  },

[
    {
        "git": "https://github.com/allecsc/mpv-qol-scripts",
        "whitelist": "scripts/notify_skip_click/",
        "base_dir": "scripts/notify_skip_click",
        "dest": "~~/scripts/ui/notify_skip",
        "branch": "main",
        "replacements": [
            {
                "search": "local bg_color = is_hover and '111111' or 'FFFFFF'  -- Black on hover or White",
                "replace": "local bg_color = is_hover and '333333' or '111111'  -- Dark bg, lighter on hover (matches hayase-osc)"
            },
            {
                "search": "local text_color = is_hover and 'FFFFFF' or '000000'  -- White text on hover or Black",
                "replace": "local text_color = 'FFFFFF'  -- White text always (matches hayase-osc)"
            },
            {
                "search": "border_color = 'FFFFFF',",
                "replace": "border_color = '444444',"
            },
            {
                "search": "mp.add_timeout(3.5, finalize_setup)",
                "replace": "mp.add_timeout(0.5, finalize_setup)"
            },
            {
                "search": "        show_skip_overlay(\"\u2716 Nothing to skip\", 2, false)\n        return false\n        \n    elseif state.mode == \"silence\" then",
                "replace": "        if state.silence_active or state.blackframe_skip_active then\n            stop_silence_skip()\n            set_time(state.skip_start_time)\n            show_skip_overlay(\"\u2713 Skip Cancelled\", 2, false)\n        else\n            init_skipping_filters()\n            start_silence_skip()\n        end\n        return true\n\n    elseif state.mode == \"silence\" then"
            }
        ]
    },
